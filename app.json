{
  "configVersion": "v3",
  "app": {
    "appId": 25381,
    "appName": "Talk Split",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.1"
    },
    "icon": "icon.png",
    "vender": "TalkSplit",
    "description": "Livesplit for your talks"
  },
  "permissions": [
    "device:os.local_storage",
    "device:os.alarm",
    "data:os.device.info"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0"
    }
  },
  "debug": false,
  "targets": {
    "gt": {
      "module": {
        "page": {
          "pages": [
            "page/gt/home/index.page"
          ]
        },
        "setting": {
          "path": "setting/index.page"
        },
        "app-side": {
          "path": "app-side/index"
        },
        "app-service": {
          "services": [
            "app-service/chapter-overrun"
          ]
        }
      },
      "platforms": [
        {
          "st": "r"
        },
        {
          "st": "s"
        }
      ],
      "designWidth": 480
    }
  },
  "i18n": {
    "de-DE": {
      "appName": "TalkSplit"
    },
    "en-US": {
      "appName": "TalkSplit"
    }
  },
  "defaultLanguage": "en-US"
}
